{
  "name": "@femati/fem-validation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Analitikus referenciamegoldások és validációs esetek a FEMAti maghoz",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --emitDeclarationOnly --outDir dist",
    "test": "vitest run",
    "report": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@femati/fem-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
