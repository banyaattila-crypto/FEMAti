{
  "name": "@femati/fem-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FEMAti számítási mag — tiszta TypeScript, nulla UI-függés",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
