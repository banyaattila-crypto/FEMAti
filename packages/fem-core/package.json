    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
