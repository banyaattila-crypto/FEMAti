{
  "name": "femati",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Rugalmas-képlékeny Timoshenko gerenda végeselemes analízis",
  "author": "Bánya Attila",
  "homepage": "https://femati.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/banyaattila-crypto/FEMAti.git"
  },
  "bugs": {
    "url": "https://github.com/banyaattila-crypto/FEMAti/issues"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && node scripts/check-design-tokens.mjs && node scripts/check-dead-css.mjs",
    "lint:fix": "eslint . --fix",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "lint:dead-css": "node scripts/check-dead-css.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "coverage": "pnpm -r coverage",
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.0"
  }
}
